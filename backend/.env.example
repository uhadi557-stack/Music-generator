# Suroor AI / Music Generator Configuration

# When true: generates a synthesized multi-track demo when no Cloud GPU is connected
ALLOW_DEMO_FALLBACK=true

# Public Gradio URL from Google Colab (e.g. https://xxxx.gradio.live)
# Leave empty if running in offline demo mode
CLOUD_GPU_URL=

# Optional: Gemini API key for dynamic lyrics (if empty, built-in authentic templates are used)
GEMINI_API_KEY=
